            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"no errors\", () => pm.expect(pm.response.json().errors).to.be.undefined);",
                  "pm.collectionVariables.set(\"bookId\", pm.response.json().data.createBook.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation CreateBook($input: BookInput!) {\n  createBook(input: $input) {\n    id\n    title\n    publishingYear\n    author {\n      name\n    }\n    publisher {\n      name\n    }\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"title\": \"Den afrikanske farm\",\n    \"authorId\": 394,\n    \"publisherId\": 74,\n    \"publishingYear\": 1937\n  }\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "graphql"
              ]
            }
