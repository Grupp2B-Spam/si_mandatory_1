  "item": [
    {
      "name": "Books",
      "item": [
        {
          "name": "Get book by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"no errors\", () => pm.expect(pm.response.json().errors).to.be.undefined);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query GetBook($id: Int!) {\n  book(id: $id) {\n    id\n    title\n    publishingYear\n    author {\n      name\n      surname\n    }\n    publisher {\n      name\n    }\n  }\n}",
                "variables": "{\n  \"id\": 1000\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "graphql"
              ]
            }
          }
        },
        {
          "name": "Create book",
